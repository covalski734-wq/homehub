{
  "name": "@homehub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "preview": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "worker:deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-schema.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:pending:remote": "wrangler d1 migrations list DB --remote",
    "db:bookmark:remote": "node scripts/d1-bookmark.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@homehub/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.148.0"
  }
}
